{
  "name": "nyxland",
  "productName": "NyxLand",
  "version": "1.0.2",
  "description": "Dynamic Island untuk Windows — notifikasi, reminder, audio mixer, catatan, dan AI Assistant.",
  "main": "app/.vite/build/main.js",
  "author": {
    "name": "Ahmad Faqod Kurnia"
  },
  "license": "MIT",
  "scripts": {
    "pack": "node scripts/pack.mjs",
    "verify": "node scripts/verify-nokey.mjs",
    "release": "npm run pack && npm run verify",
    "installer:meta": "node build/installer/setmeta.cjs build/appdir/NyxLand.exe build/icon.ico",
    "installer": "electron-builder --win nsis --prepackaged build/appdir --config build/installer/electron-builder.yml"
  },
  "keywords": [
    "dynamic-island",
    "windows",
    "electron",
    "notch",
    "ai-assistant"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Luxey9/NyxLand.git"
  },
  "homepage": "https://github.com/Luxey9/NyxLand#readme",
  "bugs": {
    "url": "https://github.com/Luxey9/NyxLand/issues"
  },
  "devDependencies": {
    "rcedit": "^4.0.1"
  },
  "dependencies": {
    "electron-builder": "^26.15.3"
  }
}
